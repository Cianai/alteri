{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(turbo:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(supabase:*)",
      "Bash(vercel:*)",
      "Bash(Rscript:*)",
      "Bash(R:*)",
      "Read",
      "Write",
      "Edit",
      "mcp__context7__*",
      "mcp__supabase__*",
      "mcp__vercel__*",
      "mcp__linear__*",
      "mcp__r-btw__*",
      "mcp__r-session__*"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf /)*"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/context7-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git branch --show-current)\" != \"main\" ] || { echo 'ERROR: Cannot edit on main branch. Create a feature branch first.' >&2; exit 1; }"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pretool-r-validate.sh \"$TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/nextjs15-params-check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$TOOL_INPUT\" == *.ts ]] || [[ \"$TOOL_INPUT\" == *.tsx ]]; then pnpm typecheck --filter=$(dirname $TOOL_INPUT) 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  }
}
