{
  "name": "alteri",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational Research Platform comparing AI alignment frameworks through Buddhist ethics evaluation",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @alteri/database db:migrate",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next"
  },
  "devDependencies": {
    "turbo": "^2.8.11",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.17.0"
  }
}
